# ---------------------------------------------------------------------------
# Local development: persistent embedded PostgreSQL (PGlite). No external
# database credentials are needed. Leave DATABASE_URL unset for this mode.
# ---------------------------------------------------------------------------
LOCAL_DATABASE_PATH=./data/pgdata
SEED_DEMO_DATA=true
SHOW_RESET_LINKS=true
APP_BASE_URL=http://localhost:3000
SESSION_TTL_DAYS=7
HELP_ESCALATION_MINUTES=15
CRON_SECRET=replace-with-a-long-random-secret
MAX_UPLOAD_BYTES=5242880
BACKUP_DIR=./backups

# Cross-site/iframe previews may need partitioned cookies. Arena sandboxes
# enable these three values automatically; uncomment them for other previews.
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true
# COOKIE_PARTITIONED=true

# Also return a browser-stored bearer token for browsers that block all
# third-party cookies. Enabled automatically in Arena sandbox previews only.
# Keep this disabled on public production deployments.
# SESSION_TOKEN_FALLBACK=true

# ---------------------------------------------------------------------------
# Production database: set DATABASE_URL to a Supabase PostgreSQL connection
# string. When set, the application uses that database instead of PGlite.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres

# Supabase authentication, private storage and realtime broadcast (optional).
# SUPABASE_AUTH_ENABLED=true
# NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]
# SUPABASE_SERVICE_ROLE_KEY=[service-role-key]
# SUPABASE_STORAGE_BUCKET=src-private
# SUPABASE_REALTIME_CHANNEL_PREFIX=srcpro
# SUPABASE_JWT_SECRET=[jwt-secret]

# ---------------------------------------------------------------------------
# External notification providers. Each channel is attempted only when its
# complete configuration is present; failures are written to delivery logs.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# NOTIFICATION_FROM_EMAIL=Tema Secondary School SRC <notifications@temasec.test>
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567
# TWILIO_WHATSAPP_FROM=whatsapp:+15551234567
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.org
